# Snowyy server
PORT=4173
WORKSPACE_ROOT=.
SESSION_STORE_PATH=.Snowyy/sessions.json

# Any OpenAI-compatible Chat Completions endpoint.
# Ollama's compatibility endpoint is the default.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=

# Windows auto-updates. Values are embedded when building an installer.
# Public GitHub repository, e.g. your-account/snowyy-releases.
SNOWYY_UPDATE_REPOSITORY=
# Optional custom HTTPS Squirrel feed instead of GitHub Releases.
SNOWYY_UPDATE_URL=
# Optional staging directory. Default: releases/win32/x64 inside this project.
SNOWYY_UPDATE_PUBLISH_DIR=
